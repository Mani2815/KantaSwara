{
  "name": "kantaswara",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx server/dev-server.ts",
    "build": "next build",
    "start": "next start",
    "start:ws": "tsx server/standalone-ws.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/validate-env.mjs && node scripts/validate-db.mjs && node scripts/copy-ort-wasm.mjs",
    "prebuild": "node scripts/validate-env.mjs && node scripts/copy-ort-wasm.mjs",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:apply": "node scripts/apply-migration.mjs",
    "db:fix": "node scripts/apply-fix.mjs",
    "db:seed": "node scripts/seed-billing.mjs",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "setup": "npm install && npm run db:setup",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@number-flow/react": "^0.6.2",
    "@prisma/adapter-pg": "^7.9.0",

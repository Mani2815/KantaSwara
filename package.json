    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@ricky0123/vad-web": "^0.0.30",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@vercel/functions": "^3.9.5",
    "bullmq": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.9",
    "nodemailer": "^9.0.3",
    "ogl": "^1.0.11",
    "onnxruntime-web": "1.19.2",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "svix": "^1.99.1",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.15",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }

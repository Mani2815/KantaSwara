{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": null,
    "watchPatterns": [
      "server/standalone-ws.ts",
      "server/services/demo/conversation-orchestrator.ts",
      "server/services/demo/deepgram-live-stt.ts",
      "server/services/demo/flux-tts-stream.ts",
      "server/services/demo/domain-personas.config.ts",
      "server/services/demo/demo.config.ts",
      "server/services/providers/llm/groq.provider.ts",
      "server/services/providers/errors.ts",
      "server/services/providers/types.ts",
      "server/package.json",
      "server/package-lock.json",
      "package.json",
      ".nvmrc",
      "tsconfig.json",
      "nixpacks.toml"
    ]
  },
  "deploy": {
    "startCommand": "npm --prefix server run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

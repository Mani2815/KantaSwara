{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install",
    "watchPatterns": [
      "server/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "nixpacks.toml"
    ]
  },
  "deploy": {
    "startCommand": "npm run start:ws",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
